    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>HmmRevive.Launcher.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
